<!-- Lucide Icons -->
<script src="https://unpkg.com/lucide@latest"></script>
<!-- Toast Utility -->
<script src="/js/toast.js"></script>

<script>
    // Initialize Lucide
    lucide.createIcons();

    /**
     * Form Fetch Interceptor
     * Automatically handles form submissions via AJAX
     */
    async function handleFormSubmit(event) {
        const form = event.target;
        if (form.getAttribute('data-no-fetch') === 'true') return;

        event.preventDefault();

        const submitBtn = form.querySelector('button[type="submit"]');
        const originalBtnText = submitBtn ? submitBtn.innerHTML : null;

        try {
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = `
                    <div class="flex items-center gap-2">
                        <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Sauvegarde...</span>
                    </div>
                `;
            }

            const formData = new FormData(form);
            const data = {};
            formData.forEach((value, key) => {
                // Handle multiple checkboxes with same name (if any) or toggles
                data[key] = value;
            });

            const response = await fetch(form.action, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: new URLSearchParams(formData).toString()
            });

            if (response.ok) {
                const url = new URL(response.url);
                const errorMsg = url.searchParams.get('error');

                if (errorMsg) {
                    window.showToast.error(decodeURIComponent(errorMsg));
                } else {
                    window.showToast.success("Réglages enregistrés avec succès !");
                }
            } else {
                throw new Error("Server returned " + response.status);
            }

        } catch (error) {
            console.error("Form submission failed:", error);
            window.showToast.error("Échec de l'enregistrement : " + error.message);
        } finally {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalBtnText;
                lucide.createIcons();
            }
        }
    }

    // Attach to all forms in the page
    document.addEventListener('DOMContentLoaded', () => {
        const forms = document.querySelectorAll('form');
        forms.forEach(form => {
            form.addEventListener('submit', handleFormSubmit);
        });
    });
</script>
