<aside class="w-64 h-[calc(100vh-4rem)] fixed left-0 top-16 glass-panel border-r border-white/5 overflow-y-auto hidden md:block">
    <div class="p-6">
        <div class="flex items-center gap-3 mb-8">
            <% if (guild.icon) { %>
                <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" class="w-10 h-10 rounded-xl shadow-lg border border-white/10">
            <% } else { %>
                <div class="w-10 h-10 rounded-xl bg-zinc-800 border border-white/10 flex items-center justify-center font-bold text-white shadow-lg">
                    <%= guild.name.charAt(0) %>
                </div>
            <% } %>
            <div>
                <h2 class="text-sm font-semibold text-white truncate w-36" title="<%= guild.name %>"><%= guild.name %></h2>
                <p class="text-xs text-zinc-500">ID: <%= guild.id %></p>
            </div>
        </div>

        <nav class="space-y-1">
            <% const tabs = [
                { id: 'general', icon: 'settings', label: 'Général' },
                { id: 'automod', icon: 'shield', label: 'Auto-Modération' },
                { id: 'welcome', icon: 'user-plus', label: 'Bienvenue & Départ' },
                { id: 'roles', icon: 'users', label: 'Auto-Role & Tickets' },
                { id: 'economy', icon: 'trending-up', label: 'Économie & Levels' },
                { id: 'logs', icon: 'list', label: 'Logs du Serveur' },
                { id: 'embeds', icon: 'layout', label: 'Embed Builder' },
                { id: 'moderation', icon: 'gavel', label: 'Modération Actions' }
            ]; %>

            <% tabs.forEach(t => { %>
                <a href="?tab=<%= t.id %>" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all <%= locals.tab === t.id ? 'bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 shadow-sm' : 'text-zinc-400 hover:text-white hover:bg-white/5' %>">
                    <i data-lucide="<%= t.icon %>" class="w-4 h-4"></i>
                    <%= t.label %>
                </a>
            <% }); %>
        </nav>
    </div>
</aside>