<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
    <%- include('partials/head', { title: 'Connexion' }) %>
</head>
<body class="bg-[#0a0a0a] min-h-screen flex items-center justify-center p-4 selection:bg-indigo-500/30">
    <div class="glass-card w-full max-w-md p-8 rounded-3xl relative overflow-hidden group">
        <!-- Subtle Glow Effect -->
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-indigo-500/20 rounded-full blur-3xl group-hover:bg-indigo-500/30 transition-all duration-500"></div>
        <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-purple-500/20 rounded-full blur-3xl group-hover:bg-purple-500/30 transition-all duration-500"></div>

        <div class="relative z-10">
            <div class="flex flex-col items-center mb-8">
                <div class="w-16 h-16 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center mb-4">
                    <i data-lucide="shield-check" class="w-8 h-8 text-indigo-400"></i>
                </div>
                <h1 class="text-2xl font-bold text-white tracking-tight">DSU-V4</h1>
                <p class="text-zinc-400 text-sm mt-1">Authentification requise</p>
            </div>

            <% if (locals.error) { %>
                <div class="bg-red-500/10 border border-red-500/20 text-red-400 p-4 rounded-xl mb-6 flex items-start gap-3">
                    <i data-lucide="alert-circle" class="w-5 h-5 shrink-0 mt-0.5"></i>
                    <p class="text-sm font-medium"><%= error %></p>
                </div>
            <% } %>

            <div class="space-y-4">
                <a href="/auth/discord" class="w-full bg-[#5865F2] text-white hover:bg-[#4752C4] font-semibold rounded-xl py-4 transition-all duration-300 flex items-center justify-center gap-3 group/btn shadow-xl shadow-indigo-500/10">
                    <i class="fab fa-discord text-xl"></i>
                    <span>Se connecter avec Discord</span>
                    <i data-lucide="arrow-right" class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform"></i>
                </a>
            </div>
        </div>
    </div>

    <%- include('partials/scripts') %>
</body>
</html>