                                <!-- Footer -->
                                <div id="previewFootContainer" class="flex items-center gap-1.5 pt-1 hidden">
                                    <p class="text-[#949ba4] text-[10px] font-medium flex items-center gap-1">
                                        <span id="previewFootText"></span>
                                        <span id="previewTimestamp" class="hidden">• Aujourd'hui à 14:42</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                function updateEmbedPreview() {
                    const title = document.getElementById('embedTitle').value;
                    const desc = document.getElementById('embedDesc').value;
                    const color = document.getElementById('embedColorText').value || '#6366f1';
                    const thumb = document.getElementById('embedThumb').value;
                    const img = document.getElementById('embedImg').value;
                    const authName = document.getElementById('embedAuthName').value;
                    const footText = document.getElementById('embedFootText').value;
                    const hasTimestamp = document.querySelector('input[name="timestamp"]').checked;

                    // Elements
                    const pTitle = document.getElementById('previewTitle');
                    const pDesc = document.getElementById('previewDesc');
                    const pColor = document.getElementById('previewColorBar');
                    const pThumb = document.getElementById('previewThumb');
                    const pImg = document.getElementById('previewImage');
                    const pAuth = document.getElementById('previewAuthContainer');
                    const pAuthName = document.getElementById('previewAuthName');
                    const pFoot = document.getElementById('previewFootContainer');
                    const pFootText = document.getElementById('previewFootText');
                    const pTime = document.getElementById('previewTimestamp');

                    // Update values
                    pTitle.innerText = title;
                    pTitle.classList.toggle('hidden', !title);

                    pDesc.innerText = desc;
                    pDesc.classList.toggle('hidden', !desc);

                    pColor.style.backgroundColor = color;

                    pThumb.src = thumb;
                    pThumb.classList.toggle('hidden', !thumb);

                    pImg.src = img;
                    pImg.classList.toggle('hidden', !img);

                    pAuthName.innerText = authName;
                    pAuth.classList.toggle('hidden', !authName);

                    pFootText.innerText = footText;
                    pFoot.classList.toggle('hidden', !footText && !hasTimestamp);

                    pTime.classList.toggle('hidden', !hasTimestamp);
                }
                // Init preview
                updateEmbedPreview();
            </script>
        <% } else if (tab === 'moderation') { %>
