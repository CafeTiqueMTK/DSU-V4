                                    <input type="text" name="thumbnail" id="embedThumb" class="w-full bg-zinc-900/50 border border-white/10 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-indigo-500" placeholder="https://..." oninput="updateEmbedPreview()">
                                </div>
                                <div>
