<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
    <%- include('partials/head') %>
</head>
<body class="bg-manus-900 text-gray-100 font-sans antialiased min-h-screen flex">
    <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

    <main class="md:ml-64 pt-16 min-h-screen p-8 flex-1 w-full">
        <header class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h1 class="text-3xl font-bold text-white tracking-tight">Configuration</h1>
                <p class="text-sm text-zinc-400 mt-1">Gérez les paramètres de <span class="text-white font-medium"><%= guild.name %></span></p>
            </div>
            <a href="/guilds" class="px-4 py-2 bg-zinc-800/50 hover:bg-zinc-800 text-sm font-medium rounded-xl border border-white/10 transition-colors flex items-center gap-2 w-fit">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Retour aux serveurs
            </a>
        </header>

        <% if (locals.success) { %>
            <div class="mb-6 p-4 rounded-xl bg-green-500/10 border border-green-500/20 text-green-400 flex items-center gap-3">
                <i data-lucide="check-circle" class="w-5 h-5 shrink-0"></i>
                <p class="text-sm font-medium">Modifications enregistrées avec succès.</p>
            </div>
        <% } %>

        <% if (locals.error) { %>
            <div class="mb-6 p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 flex items-center gap-3">
                <i data-lucide="alert-circle" class="w-5 h-5 shrink-0"></i>
                <p class="text-sm font-medium"><%= error %></p>
            </div>
        <% } %>

        <% if (tab === 'general') { %>
            <form action="/guilds/<%= guild.id %>/settings/general" method="POST" class="max-w-2xl">
                <div class="glass-card rounded-2xl p-6 space-y-6">
                    <div>
                        <h2 class="text-lg font-semibold text-white flex items-center gap-2">
                            <i data-lucide="settings-2" class="w-5 h-5 text-indigo-400"></i>
                            Paramètres Généraux
                        </h2>
                        <p class="text-sm text-zinc-400 mt-1">Configurez les informations de base du bot.</p>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-zinc-300 mb-1.5">Préfixe des commandes</label>
                            <input type="text" name="prefix" value="<%= settings.prefix || '!' %>" class="w-full bg-zinc-900/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all placeholder-zinc-600">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-zinc-300 mb-1.5">Langue</label>
                            <div class="relative">
                                <select name="language" class="w-full bg-zinc-900/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500 transition-all appearance-none">
                                    <option value="fr" <%= settings.language === 'fr' ? 'selected' : '' %>>Français</option>
                                    <option value="en" <%= settings.language === 'en' ? 'selected' : '' %>>English</option>
                                </select>
                                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-zinc-400">
                                    <i data-lucide="chevron-down" class="w-4 h-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-white/10">
                        <button type="submit" class="bg-indigo-500 hover:bg-indigo-600 text-white text-sm font-medium px-6 py-2.5 rounded-xl transition-colors shadow-lg shadow-indigo-500/20">
                            Enregistrer les modifications
                        </button>
                    </div>
                </div>
            </form>
        <% } else if (tab === 'automod') { %>
            <form action="/guilds/<%= guild.id %>/settings/automod" method="POST">
                <div class="glass-card rounded-2xl p-6 mb-8 max-w-4xl">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-lg font-semibold text-white flex items-center gap-2">
                                <i data-lucide="shield-check" class="w-5 h-5 text-indigo-400"></i>
                                Configuration Globale
                            </h2>
                            <p class="text-sm text-zinc-400 mt-1">Activez l'Automod et définissez le salon d'alerte principal.</p>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" name="automod_enabled" class="sr-only peer" <%= settings.automod?.enabled ? 'checked' : '' %>>
                            <div class="w-11 h-6 bg-zinc-800 border border-white/10 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-zinc-300 after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-500 peer-checked:border-indigo-500 peer-checked:after:bg-white"></div>
                        </label>
                    </div>

                    <div class="mt-6">
                        <label class="block text-sm font-medium text-zinc-300 mb-1.5">Salon d'alerte</label>
                        <div class="relative max-w-md">
                            <select name="automod_channel" class="w-full bg-zinc-900/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500 transition-all appearance-none">
                                <option value="">Aucun salon sélectionné</option>
                                <% channels.forEach(ch => { %>
                                    <option value="<%= ch.id %>" <%= settings.automod?.actionChannel === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                                <% }) %>
                            </select>
                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-zinc-400">
                                <i data-lucide="chevron-down" class="w-4 h-4"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bento-grid max-w-4xl mb-8">
                    <%
                        const modules = [
                            { name: 'antiSpam', label: 'Anti-Spam', desc: 'Bloque les messages répétés trop rapidement', icon: 'message-square-off' },
                            { name: 'antiInvites', label: 'Anti-Invitations', desc: 'Supprime les liens d\'invitation vers d\'autres serveurs', icon: 'link-2-off' },
                            { name: 'antiLinks', label: 'Anti-Liens', desc: 'Interdit le partage de liens web non autorisés', icon: 'globe' },
                            { name: 'antiRaid', label: 'Anti-Raid', desc: 'Détecte et bloque les arrivées massives (raids)', icon: 'users' },
                            { name: 'antiMassMention', label: 'Anti-Mentions', desc: 'Empêche le spam abusif de mentions', icon: 'at-sign' }
                        ];
                        modules.forEach(mod => {
                    %>
                        <div class="glass-card rounded-2xl p-5 flex items-start justify-between gap-4">
                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-xl bg-zinc-800/80 border border-white/5 flex items-center justify-center shrink-0">
                                    <i data-lucide="<%= mod.icon %>" class="w-5 h-5 text-indigo-400"></i>
                                </div>
                                <div>
                                    <h3 class="text-sm font-semibold text-white"><%= mod.label %></h3>
                                    <p class="text-xs text-zinc-400 mt-1 leading-relaxed"><%= mod.desc %></p>
                                </div>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer shrink-0 mt-1">
                                <input type="checkbox" name="<%= mod.name %>" class="sr-only peer" <%= settings[mod.name]?.enabled ? 'checked' : '' %>>
                                <div class="w-9 h-5 bg-zinc-800 border border-white/10 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-zinc-300 after:border-zinc-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-500 peer-checked:border-indigo-500 peer-checked:after:bg-white"></div>
                            </label>
                        </div>
                    <% }) %>
                </div>

                <button type="submit" class="bg-indigo-500 hover:bg-indigo-600 text-white text-sm font-medium px-6 py-2.5 rounded-xl transition-colors shadow-lg shadow-indigo-500/20">
                    Enregistrer l'Automod
                </button>
            </form>
        <% } else if (tab === 'welcome') { %>
            <div class="grid grid-cols-1 xl:grid-cols-2 gap-8 max-w-6xl">
                <form action="/guilds/<%= guild.id %>/settings/welcome" method="POST" class="space-y-8">
                    <!-- Welcome -->
                    <div class="glass-card rounded-2xl p-6">
                        <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
                            <div>
                                <h2 class="text-lg font-semibold text-white flex items-center gap-2">
                                    <i data-lucide="user-plus" class="w-5 h-5 text-green-400"></i>
                                    Message de Bienvenue
                                </h2>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" name="welcome_enabled" class="sr-only peer" <%= settings.welcome?.enabled ? 'checked' : '' %>>
                                <div class="w-11 h-6 bg-zinc-800 border border-white/10 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-zinc-300 after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-500 peer-checked:border-green-500 peer-checked:after:bg-white"></div>
                            </label>
                        </div>

                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-medium text-zinc-300 mb-1.5">Salon d'annonce</label>
                                <div class="relative">
                                    <select name="welcome_channel" class="w-full bg-zinc-900/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-green-500 transition-all appearance-none">
                                        <option value="">Aucun salon</option>
                                        <% channels.filter(c => c.type === 0).forEach(ch => { %>
                                            <option value="<%= ch.id %>" <%= settings.welcome?.channel === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                                        <% }) %>
                                    </select>
                                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-zinc-400">
                                        <i data-lucide="chevron-down" class="w-4 h-4"></i>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-zinc-300 mb-1.5">Message personnalisé</label>
                                <textarea name="welcome_message" id="welcomeMsg" rows="3" class="w-full bg-zinc-900/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-green-500 transition-all resize-none" placeholder="Bienvenue {user} sur {server} !" oninput="updateWelcomePreview()"><%= settings.welcome?.message || '' %></textarea>
                                <p class="text-[10px] text-zinc-500 mt-1 uppercase tracking-wider font-bold">Variables : {user}, {server}, {memberCount}</p>
                            </div>
                        </div>
                    </div>

                    <!-- Farewell -->
                    <div class="glass-card rounded-2xl p-6">
                        <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
                            <div>
                                <h2 class="text-lg font-semibold text-white flex items-center gap-2">
                                    <i data-lucide="user-minus" class="w-5 h-5 text-red-400"></i>
                                    Message de Départ
                                </h2>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" name="farewell_enabled" class="sr-only peer" <%= settings.farewell?.enabled ? 'checked' : '' %>>
                                <div class="w-11 h-6 bg-zinc-800 border border-white/10 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-zinc-300 after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-red-500 peer-checked:border-red-500 peer-checked:after:bg-white"></div>
                            </label>
                        </div>

                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-medium text-zinc-300 mb-1.5">Salon d'annonce</label>
                                <div class="relative">
                                    <select name="farewell_channel" class="w-full bg-zinc-900/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-red-500 transition-all appearance-none">
                                        <option value="">Aucun salon</option>
                                        <% channels.filter(c => c.type === 0).forEach(ch => { %>
                                            <option value="<%= ch.id %>" <%= settings.farewell?.channel === ch.id ? 'selected' : '' %>># <%= ch.name %></option>
                                        <% }) %>
                                    </select>
                                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-zinc-400">
                                        <i data-lucide="chevron-down" class="w-4 h-4"></i>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-zinc-300 mb-1.5">Message personnalisé</label>
                                <textarea name="farewell_message" id="farewellMsg" rows="3" class="w-full bg-zinc-900/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-red-500 transition-all resize-none" placeholder="{user} vient de nous quitter." oninput="updateWelcomePreview()"><%= settings.farewell?.message || '' %></textarea>
                                <p class="text-[10px] text-zinc-500 mt-1 uppercase tracking-wider font-bold">Variables : {user}, {server}</p>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-indigo-500 hover:bg-indigo-600 text-white font-bold py-4 rounded-2xl transition-all shadow-lg shadow-indigo-500/20 active:scale-[0.98]">
                        Enregistrer les messages
                    </button>
                </form>

                <!-- Preview Area -->
                <div class="sticky top-24 h-fit space-y-6">
                    <div class="glass-card rounded-2xl p-6 bg-zinc-900/30">
                        <h3 class="text-xs font-bold text-zinc-500 uppercase tracking-widest mb-4 flex items-center gap-2">
                            <i data-lucide="eye" class="w-4 h-4"></i>
                            Aperçu Bienvenue
                        </h3>
                        <div class="bg-[#2b2d31] p-4 rounded-lg shadow-xl border border-black/20">
                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-full bg-zinc-700 shrink-0 overflow-hidden">
                                    <img src="<%= bot.user.displayAvatarURL() %>" alt="" class="w-full h-full object-cover opacity-50 grayscale">
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 mb-0.5">
                                        <span class="text-white text-sm font-semibold hover:underline cursor-pointer tracking-tight"><%= bot.user.username %></span>
                                        <span class="bg-indigo-500 text-white px-1.5 py-0.5 rounded text-[9px] uppercase font-bold tracking-tighter">Bot</span>
                                        <span class="text-[#949ba4] text-[10px] font-medium">Aujourd'hui à 14:42</span>
                                    </div>
                                    <p id="welcomePreview" class="text-zinc-200 text-sm whitespace-pre-wrap break-words leading-relaxed"></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="glass-card rounded-2xl p-6 bg-zinc-900/30">
                        <h3 class="text-xs font-bold text-zinc-500 uppercase tracking-widest mb-4 flex items-center gap-2">
                            <i data-lucide="eye" class="w-4 h-4"></i>
                            Aperçu Départ
                        </h3>
                        <div class="bg-[#2b2d31] p-4 rounded-lg shadow-xl border border-black/20">
                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-full bg-zinc-700 shrink-0 overflow-hidden">
                                    <img src="<%= bot.user.displayAvatarURL() %>" alt="" class="w-full h-full object-cover opacity-50 grayscale">
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 mb-0.5">
                                        <span class="text-white text-sm font-semibold hover:underline cursor-pointer tracking-tight"><%= bot.user.username %></span>
                                        <span class="bg-indigo-500 text-white px-1.5 py-0.5 rounded text-[9px] uppercase font-bold tracking-tighter">Bot</span>
                                        <span class="text-[#949ba4] text-[10px] font-medium">Aujourd'hui à 14:42</span>
                                    </div>
                                    <p id="farewellPreview" class="text-zinc-200 text-sm whitespace-pre-wrap break-words leading-relaxed"></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                function updateWelcomePreview() {
                    const wMsg = document.getElementById('welcomeMsg').value || 'Bienvenue {user} sur {server} !';
                    const fMsg = document.getElementById('farewellMsg').value || '{user} vient de nous quitter.';

                    const serverName = "<%= guild.name %>";
                    const userName = "PseudoUtilisateur";

                    const format = (text) => text
                        .replace(/{user}/g, `**${userName}**`)
                        .replace(/{server}/g, `**${serverName}**`)
                        .replace(/{memberCount}/g, `**1,337**`);

                    document.getElementById('welcomePreview').textContent = format(wMsg);
                    document.getElementById('farewellPreview').textContent = format(fMsg);
                }
                updateWelcomePreview();
            </script>
        <% } else if (tab === 'roles') { %>
            <form action="/guilds/<%= guild.id %>/settings/roles" method="POST" class="max-w-4xl space-y-8">
                <div class="glass-card rounded-2xl p-6">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="text-lg font-semibold text-white flex items-center gap-2">
                                <i data-lucide="award" class="w-5 h-5 text-indigo-400"></i>
                                Auto-Role
                            </h2>
                            <p class="text-sm text-zinc-400 mt-1">Attribue automatiquement un rôle aux nouveaux membres.</p>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" name="autorole_enabled" class="sr-only peer" <%= settings.autorole?.enabled ? 'checked' : '' %>>
                            <div class="w-11 h-6 bg-zinc-800 border border-white/10 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-zinc-300 after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-500 peer-checked:border-indigo-500 peer-checked:after:bg-white"></div>
                        </label>
                    </div>

                    <div class="max-w-md">
                        <label class="block text-sm font-medium text-zinc-300 mb-1.5">Rôle à attribuer</label>
                        <div class="relative">
                            <select name="autorole_roleId" class="w-full bg-zinc-900/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500 transition-all appearance-none">
                                <option value="">Sélectionnez un rôle...</option>
                                <% roles.forEach(role => { %>
                                    <option value="<%= role.id %>" <%= settings.autorole?.roleId === role.id ? 'selected' : '' %>>@ <%= role.name %></option>
                                <% }) %>
                            </select>
                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-zinc-400">
                                <i data-lucide="chevron-down" class="w-4 h-4"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="glass-card rounded-2xl p-6">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="text-lg font-semibold text-white flex items-center gap-2">
                                <i data-lucide="ticket" class="w-5 h-5 text-indigo-400"></i>
                                Système de Tickets
                            </h2>
                            <p class="text-sm text-zinc-400 mt-1">Gérez le rôle du support technique.</p>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" name="tickets_enabled" class="sr-only peer" <%= settings.tickets?.enabled ? 'checked' : '' %>>
                            <div class="w-11 h-6 bg-zinc-800 border border-white/10 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-zinc-300 after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-500 peer-checked:border-indigo-500 peer-checked:after:bg-white"></div>
                        </label>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-zinc-300 mb-1.5">Rôle de Support (Staff)</label>
                            <div class="relative">
                                <select name="tickets_roleId" class="w-full bg-zinc-900/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500 transition-all appearance-none">
                                    <option value="">Sélectionnez un rôle...</option>
                                    <% roles.forEach(role => { %>
                                        <option value="<%= role.id %>" <%= settings.tickets?.supportRoleId === role.id ? 'selected' : '' %>>@ <%= role.name %></option>
                                    <% }) %>
                                </select>
                                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-zinc-400">
                                    <i data-lucide="chevron-down" class="w-4 h-4"></i>
                                </div>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-zinc-300 mb-1.5">Catégorie des tickets</label>
                            <div class="relative">
                                <select name="tickets_categoryId" class="w-full bg-zinc-900/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500 transition-all appearance-none">
                                    <option value="">Sélectionnez une catégorie...</option>
                                    <% channels.filter(c => c.type === 4).forEach(cat => { %>
                                        <option value="<%= cat.id %>" <%= settings.tickets?.ticketsCategory === cat.id ? 'selected' : '' %>>📁 <%= cat.name %></option>
                                    <% }) %>
                                </select>
                                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-zinc-400">
                                    <i data-lucide="chevron-down" class="w-4 h-4"></i>
                                </div>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-zinc-300 mb-1.5">Préfixe des salons de ticket</label>
                            <input type="text" name="tickets_ticketPrefix" value="<%= settings.tickets?.ticketPrefix || 'ticket' %>" class="w-full bg-zinc-900/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500 transition-all placeholder-zinc-600">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-zinc-300 mb-1.5">Message de bienvenue (Tickets)</label>
                            <textarea name="tickets_welcomeMessage" rows="2" class="w-full bg-zinc-900/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500 transition-all resize-none" placeholder="Bienvenue dans votre ticket..."><%= settings.tickets?.welcomeMessage || '' %></textarea>
                        </div>
                    </div>
                </div>

