                        <div class="pt-4 border-t border-white/5">
                            <button type="submit" class="w-full bg-indigo-500 hover:bg-indigo-600 text-white text-sm font-bold py-3 rounded-xl transition-all shadow-lg shadow-indigo-500/20 active:scale-[0.98]">
                                Appliquer la sanction
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Bulk Delete Card -->
                <div class="glass-card rounded-2xl p-6 h-fit">
                    <div class="mb-6">
                        <h2 class="text-lg font-semibold text-white flex items-center gap-2">
                            <i data-lucide="trash-2" class="w-5 h-5 text-red-400"></i>
