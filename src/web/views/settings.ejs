                    </div>

                    <form action="/guilds/<%= guild.id %>/settings/moderation" method="POST" class="space-y-5">
                        <input type="hidden" name="action" value="clear">
                        <div>
                            <label class="block text-sm font-medium text-zinc-300 mb-1.5">Salon</label>
                            <div class="relative">
                                <select name="channelId" class="w-full bg-zinc-900/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500 appearance-none">
                                    <% channels.filter(c => c.type === 0).forEach(ch => { %>
                                        <option value="<%= ch.id %>"># <%= ch.name %></option>
                                    <% }) %>
                                </select>
                                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-zinc-400">
                                    <i data-lucide="chevron-down" class="w-4 h-4"></i>
                                </div>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-zinc-300 mb-1.5">Quantité (1-100)</label>
                            <input type="number" name="amount" min="1" max="100" value="10" class="w-full bg-zinc-900/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500">
                        </div>

                        <div class="pt-4 border-t border-white/5">
                            <button type="submit" class="w-full bg-red-500/80 hover:bg-red-600 text-white text-sm font-bold py-3 rounded-xl transition-all shadow-lg shadow-red-500/20 active:scale-[0.98]">
                                Purger les messages
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        <% } %>
    </main>

    <%- include('partials/scripts') %>
</body>
</html>