                                    <label class="block text-sm font-medium text-zinc-300 mb-1.5">Couleur</label>
                                    <div class="flex items-center gap-2">
                                        <input type="color" id="embedColorPicker" value="#6366f1" class="w-10 h-10 rounded-lg cursor-pointer bg-transparent border-0" oninput="document.getElementById('embedColorText').value = this.value; updateEmbedPreview()">
