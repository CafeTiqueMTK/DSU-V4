                                <label class="flex items-center gap-2 p-2.5 rounded-xl border border-white/5 bg-zinc-900/30 cursor-pointer hover:bg-white/5 transition-colors has-[:checked]:border-indigo-500/50 has-[:checked]:bg-indigo-500/5">
