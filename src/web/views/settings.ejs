                                        <input type="text" name="authorName" id="embedAuthName" class="w-full bg-zinc-900/50 border border-white/10 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-indigo-500" placeholder="Nom..." oninput="updateEmbedPreview()">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-zinc-300 mb-1.5">Texte de footer</label>
                                        <input type="text" name="footerText" id="embedFootText" class="w-full bg-zinc-900/50 border border-white/10 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-indigo-500" placeholder="Bas de page..." oninput="updateEmbedPreview()">
