                                    <input type="radio" name="action" value="mute" class="hidden peer" onchange="document.getElementById('durationField').classList.remove('hidden')">
                                    <span class="text-xs text-zinc-300 peer-checked:text-white">Mute (Timeout)</span>
                                </label>
                                <label class="flex items-center gap-2 p-2.5 rounded-xl border border-white/5 bg-zinc-900/30 cursor-pointer hover:bg-white/5 transition-colors has-[:checked]:border-orange-500/50 has-[:checked]:bg-orange-500/5">
                                    <input type="radio" name="action" value="kick" class="hidden peer" onchange="document.getElementById('durationField').classList.add('hidden')">
                                    <span class="text-xs text-zinc-300 peer-checked:text-white">Expulser</span>
