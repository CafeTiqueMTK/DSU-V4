# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
OWNER_ID=your_discord_user_id_here
MONGODB_URI=mongodb://localhost:27017/dsu-v4

# Web Server Configuration
WEB_PORT=3000
SESSION_SECRET=your_session_secret_here
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=password123

# Rescue & Monitoring
RESCUE_WEBHOOK_URL=your_discord_webhook_url_here

# WhatsApp Alerts (CallMeBot)
WHATSAPP_PHONE=your_phone_number_international_format
WHATSAPP_API_KEY=your_callmebot_api_key

# Optional Configuration
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repo_name
DATA_PATH=./data
DEPLOY_COMMANDS=true
GITHUB_TOKEN=your_github_token_for_updates
PORT=3000
